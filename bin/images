#!/usr/bin/env ruby

require 'yaml'
require 'json'
require 'optparse'
require 'fileutils'

class Image
  REPOSITORY       = 'silex/emacs'
  CACHE_REPOSITORY = 'ghcr.io/silex/emacs-cache'
  SOURCE_URL       = 'https://github.com/Silex/docker-emacs'
  IMAGES_YML       = 'images.yml'

  attr_reader :os
  attr_reader :version
  attr_reader :subdir

  class << self
    def all
      versions.flat_map do |version|
        buildable_oses(version).flat_map do |os|
          root = Image.new(version: version, os: os, subdir: nil)
          children = buildable_subdirs(version).map do |subdir|
            Image.new(version: version, os: os, subdir: subdir)
          end
          [root] + children
        end
      end
    end

    def data
      @data ||= YAML.safe_load(File.read(IMAGES_YML), symbolize_names: false)
    end

    def versions
      data['versions'].map(&:to_s)
    end

    def oses
      data['oses']
    end

    def subdirs
      Array(data['subdirs'])
    end

    def cache_bust_versions
      Array(data['cache_bust']).map(&:to_s)
    end

    def major_latests
      versions
        .reject { |v| v == 'master' }
        .group_by(&:to_i)
        .map { |_, vs| vs.sort.last }
        .sort
    end

    def exclusions
      # Normalize the version to a string and the subdir list to an array,
      # without writing back into the memoized YAML.
      @exclusions ||= Array(data['exclusions']).map do |entry|
        entry.each_with_object({}) do |(key, value), normalized|
          normalized[key] = case key
                            when 'version' then value.to_s
                            when 'subdirs' then Array(value).map(&:to_s)
                            else value
                            end
        end
      end
    end

    # A version may carry several exclusion entries; every one of them applies.
    def exclusions_for(version)
      exclusions.select { |entry| entry['version'] == version }
    end

    def excluded_oses(version)
      exclusions_for(version).flat_map { |entry| Array(entry['os']) }.uniq
    end

    def excluded_subdirs(version)
      exclusions_for(version).flat_map { |entry| Array(entry['subdirs']) }.uniq
    end

    def buildable_oses(version)
      oses - excluded_oses(version)
    end

    def buildable_subdirs(version)
      subdirs - excluded_subdirs(version)
    end

    def github
      {
        include: github_include,
        exclude: github_exclude
      }
    end

    def github_include
      include = [{ subdirs: subdirs }]
      versions.each do |version|
        excluded = excluded_subdirs(version)
        next if excluded.empty?

        include << { version: version, subdirs: subdirs - excluded }
      end
      include
    end

    def github_exclude
      versions.flat_map do |version|
        excluded_oses(version).map do |os|
          { version: version, os: os }
        end
      end
    end

    def to_json
      {
        versions: versions,
        oses: oses,
        subdirs: subdirs,
        exclusions: exclusions,
        cache_bust: cache_bust_versions,
        github: github,
        images: all
      }.to_json
    end
  end

  def initialize(version:, os:, subdir:)
    @version = version
    @os      = os
    @subdir  = subdir
  end

  def major_latest?
    self.class.major_latests.include?(version)
  end

  def latest?
    self.class.major_latests.last == version
  end

  def tags
    tag_variants.flat_map { |variant| tags_for_variant(variant) }
  end

  def tags_with_repository
    tags.map do |s|
      format('%s:%s', REPOSITORY, s)
    end
  end

  def cache
    format('%s:%s', CACHE_REPOSITORY, tags.first)
  end

  # Returns the corresponding Nix version.
  def nix_version
    return 'emacs-snapshot' if version == 'master'
    format('emacs-%s', version.gsub('.', '-'))
  end

  def directory
    parts = [version, os, subdir].compact
    File.join('images', *parts)
  end

  def dockerfile
    File.join(directory, 'Dockerfile')
  end

  def template
    return File.join('templates', os, 'Dockerfile') unless subdir

    File.join('templates', os, subdir, 'Dockerfile')
  end

  def depends
    return nil unless subdir

    parent = self.class.new(version: version, os: os, subdir: parent_subdir)
    parent.tags_with_repository.first
  end

  def parent_subdir
    return nil unless subdir

    parent, _sep, _leaf = subdir.rpartition('/')
    parent.empty? ? nil : parent
  end

  def tag_variants
    return [nil] unless subdir

    segments = subdir.split('/')
    (0...segments.length).map { |i| segments[i..-1].join('-') }
  end

  def tags_for_variant(variant)
    tags = [tag_with_os(variant)]
    tags << tag_pretty(variant) if os == 'debian'

    if major_latest?
      tags += tags.map { |t| t.sub(/\.\d+/, '') }
      tags << latest_tag(variant) if latest?
    end

    tags
  end

  def tag_with_os(variant)
    return format('%s-%s', version, os) unless variant

    format('%s-%s-%s', version, os, variant)
  end

  def tag_pretty(variant)
    return version unless variant

    format('%s-%s', version, variant)
  end

  def latest_tag(variant)
    if os == 'debian'
      return 'latest' unless variant

      return variant
    end

    return os unless variant

    format('%s-%s', os, variant)
  end

  def to_json(options = nil)
    {
      version: version,
      os: os,
      subdir: subdir,
      nix_version: nix_version,
      directory: directory,
      dockerfile: dockerfile,
      tags: tags,
      tags_with_repository: tags_with_repository,
      cache: cache,
      depends: depends,
      cache_bust: self.class.cache_bust_versions.include?(version),
      major_latest?: major_latest?,
      latest?: latest?,
    }.to_json
  end
end

CACHE_BUST_LINE = 'ADD https://api.github.com/repos/purcell/nix-emacs-ci/commits?per_page=1 /tmp/cache'
README_TEMPLATE = File.join('templates', 'README.md')

# Docker Hub truncates a repository description past this many bytes, which is
# why README.dockerhub.md lists fewer tags than README.md.
DOCKERHUB_DESCRIPTION_LIMIT = 25_000

# Renders every generated file to a { path => content } map. Nothing is written,
# so a caller may write the result or compare it against the working tree.
def rendered_files(images)
  files = {}
  images.each { |image| files[image.dockerfile] = render_dockerfile(image) }
  files.merge(render_readmes(images))
end

def render_dockerfile(image)
  abort format('Dockerfile template not found at %s', image.template) unless File.exist?(image.template)

  cache_bust = Image.cache_bust_versions.include?(image.version) ? "\n#{CACHE_BUST_LINE}" : ''

  content = File.read(image.template)
  content = content.gsub('{{NIX_VERSION}}', image.nix_version)
  content = content.gsub("\n{{CACHE_BUST}}", cache_bust)
  content = content.gsub('{{DEPENDS}}', image.depends) if image.depends
  content
end

def tag_bullets(images)
  # Group by version and reverse the order so the newest comes first.
  bullets = images.group_by(&:version).values.reverse.flatten.map do |image|
    format('- [%s](%s/blob/main/%s)',
           image.tags.map { |tag| format('`%s`', tag) }.join(', '),
           Image::SOURCE_URL,
           image.dockerfile)
  end
  bullets.join("\n")
end

def render_readmes(images)
  abort format('README template not found at %s', README_TEMPLATE) unless File.exist?(README_TEMPLATE)

  template = File.read(README_TEMPLATE)

  # Only master and the latest release of each major, to stay under the limit.
  latest_versions = Image.major_latests
  short = images.select do |image|
    image.version == 'master' || latest_versions.include?(image.version)
  end

  dockerhub = template.gsub('{{TAGS}}', tag_bullets(short))
  dockerhub = dockerhub.sub('## Tags', format("## Tags\n\nFull image list: %s#tags", Image::SOURCE_URL))

  {
    'README.md' => template.gsub('{{TAGS}}', tag_bullets(images)),
    'README.dockerhub.md' => dockerhub
  }
end

def verify_dockerhub_size(files)
  size = files['README.dockerhub.md'].bytesize
  return if size <= DOCKERHUB_DESCRIPTION_LIMIT

  abort format('README.dockerhub.md is %d bytes, over the %d byte Docker Hub description limit. Reduce the tags it lists.',
               size, DOCKERHUB_DESCRIPTION_LIMIT)
end

def generate(files)
  puts '>>> generating the Dockerfiles and READMEs'
  # images/ holds nothing but generated Dockerfiles, so removing it also drops
  # the directories of a version deleted from images.yml.
  FileUtils.rm_rf('images')

  files.each do |path, content|
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, content)
  end
end

def check(files)
  problems = files.filter_map do |path, content|
    next format('%-10s %s', 'missing:', path) unless File.exist?(path)
    next format('%-10s %s', 'differs:', path) if File.read(path) != content
  end

  extra = Dir.glob(File.join('images', '**', 'Dockerfile')).sort - files.keys
  problems += extra.map { |path| format('%-10s %s', 'orphaned:', path) }

  if problems.empty?
    puts 'Generated files are up to date.'
    return
  end

  warn 'Generated files do not match images.yml and templates/. Run bin/images --generate.'
  problems.each { |problem| warn format('  %s', problem) }
  exit 1
end

def run(options)
  if options[:generate] || options[:check]
    files = rendered_files(Image.all)
    verify_dockerhub_size(files)
    generate(files) if options[:generate]
    check(files) if options[:check]
  end

  puts Image.to_json if options[:json]
end

def parse_options
  options = {}
  parser = OptionParser.new do |opts|
    opts.banner = 'Usage: images [options]'
    opts.separator ''
    opts.separator 'Generate the Dockerfiles & README or return images JSON.'

    opts.on('--generate', 'Generate Dockerfiles and README') do
      options[:generate] = true
    end

    opts.on('--check', 'Verify the generated files are up to date') do
      options[:check] = true
    end

    opts.on('--json', 'Output images as JSON') do
      options[:json] = true
    end

    opts.on('-h', '--help', 'Print usage') do
      puts opts
      exit
    end
  end

  begin
    parser.parse!
  rescue OptionParser::InvalidOption => e
    warn e.message
    warn parser
    exit(1)
  end

  if options.empty?
    warn parser
    exit(1)
  end

  options
end

def main
  options = parse_options
  Dir.chdir(File.expand_path('..', __dir__)) do
    run(options)
  end
end

main
