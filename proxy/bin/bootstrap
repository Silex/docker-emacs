#!/usr/bin/env bash
set -euo pipefail

# Copy template env files to data/ if they don't already exist
rsync -a --ignore-existing templates/data/ data/

# Secure env files
find data/ -name '*.env' -exec chmod 600 {} \;

echo 'Setup complete. Edit env files in data/*/config/.env, then:'
echo '  docker compose up -d'
